{
  "info": {
    "name": "Payment Entity - PostgreSQL regression",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Local mock gateway tests. Creates and retains identifiable test financial records. No credentials required. Run in order."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9080"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === 'Create payment') { pm.collectionVariables.set('runId', pm.variables.replaceIn('{{$guid}}')); pm.collectionVariables.set('bookingId', String(Date.now())); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Create payment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/payments",
        "body": {
          "mode": "raw",
          "raw": "{\"bookingId\": {{bookingId}}, \"userId\": 1, \"bookingAmount\": 500, \"discountAmount\": 0, \"currency\": \"INR\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const b = pm.response.json();",
              "pm.test(\"CREATED\", () => { pm.expect(b.data.paymentStatus).to.eql('CREATED'); });",
              "if (pm.response.code === 201) pm.collectionVariables.set('paymentId', b.data.paymentId);"
            ]
          }
        }
      ]
    },
